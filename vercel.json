{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "print_agent": {
      "root": "print_agent",
      "runtime": "python",
      "entrypoint": "api/index.py",
      "bindings": [
        {
          "type": "service",
          "service": "web",
          "format": "url",
          "env": "WEB_API_URL"
        }
      ]
    },
    "web": {
      "root": "web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
