# Supabase Public API (Accessible from browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (Server-side ONLY for admin tasks and storage cleanup purge)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron Secret for automated cleanup API calls
CRON_SECRET=super-secret-purge-key-9988
